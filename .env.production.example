DJANGO_SECRET_KEY=generate-a-random-secret-of-at-least-50-characters
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=tender.wildberries.ru
CSRF_TRUSTED_ORIGINS=https://tender.wildberries.ru
POSTGRES_DB=tenderflow
POSTGRES_USER=tenderflow
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_HOST=db
MINIO_ROOT_USER=tenderflow
MINIO_ROOT_PASSWORD=replace-with-strong-password
AWS_ACCESS_KEY_ID=tenderflow
AWS_SECRET_ACCESS_KEY=replace-with-strong-password
AWS_STORAGE_BUCKET_NAME=tenderflow
AWS_S3_ENDPOINT_URL=http://minio:9000
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2
DB_CONN_MAX_AGE=60
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=WB Tender <noreply@wildberries.ru>
EMAIL_HOST=smtp.example.ru
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=1
